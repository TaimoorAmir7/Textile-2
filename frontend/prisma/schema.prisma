generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Plant {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  location    String
  healthScore Int     @default(90)
  assets      Asset[]
}

model AssetFamily {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  name        String
  description String
  specs       Json
  challenges  Json
  useCases    Json
  templates   ReliabilityTemplate[]
  assets      Asset[]
}

model ReliabilityTemplate {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  version      String
  overview     String
  signals      Json
  failureModes Json
  familyId     String
  family       AssetFamily  @relation(fields: [familyId], references: [id])
  assets       Asset[]
  deployments  Deployment[]
}

model Asset {
  id           String              @id @default(cuid())
  assetCode    String              @unique
  name         String
  location     String
  healthScore  Int
  status       String
  monitored    Boolean             @default(false)
  model        String
  lastService  String
  plantId      String
  plant        Plant               @relation(fields: [plantId], references: [id])
  familyId     String
  family       AssetFamily         @relation(fields: [familyId], references: [id])
  templateId   String?
  template     ReliabilityTemplate? @relation(fields: [templateId], references: [id])
  mappings     SignalMapping[]
  alerts       Alert[]
  cases        Case[]
  deployments  DeploymentAsset[]
}

model SignalMapping {
  id        String @id @default(cuid())
  signalKey String
  tagName   String
  assetId   String
  asset     Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Deployment {
  id         String             @id @default(cuid())
  status     String
  qualityPct Int                @default(96)
  parameters Json
  createdAt  DateTime           @default(now())
  templateId String
  template   ReliabilityTemplate @relation(fields: [templateId], references: [id])
  assets     DeploymentAsset[]
}

model DeploymentAsset {
  deploymentId String
  assetId      String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([deploymentId, assetId])
}

model Alert {
  id         String      @id @default(cuid())
  title      String
  severity   String
  status     String
  detectedAt DateTime
  payload    Json
  assetId    String
  asset      Asset       @relation(fields: [assetId], references: [id])
  cases      CaseAlert[]
}

model Case {
  id           String      @id @default(cuid())
  caseCode     String      @unique
  title        String
  description  String      @default("")
  priority     String
  status       String
  assignee     String?
  workOrderRef String?
  createdAt    DateTime    @default(now())
  assetId      String
  asset        Asset       @relation(fields: [assetId], references: [id])
  alerts       CaseAlert[]
}

model CaseAlert {
  caseId  String
  alertId String
  case    Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([caseId, alertId])
}
