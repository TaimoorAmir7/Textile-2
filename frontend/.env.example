# Local (default): SQLite file next to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Vercel + Neon (shared persistence): create a Neon project, then
# 1. Change prisma/schema.prisma datasource provider to "postgresql"
# 2. Set this env on Vercel to the Neon pooled URL:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
